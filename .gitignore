# SAGE — .gitignore

# Environment — NEVER commit keys
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
venv/
env/
.venv/
.env.example
env*/

# Database
*.db
*.sqlite
*.sqlite3

# SAGE runtime output — never commit
data/
outputs/
demos/

# synapse_graphs — only demo.html is public, everything else private
synapse_graphs/*
!synapse_graphs/demo.html

# JSON ignored globally
*.json
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo


# Files to be ignored
SAGE_Project_Brief.docx
*synapse.html