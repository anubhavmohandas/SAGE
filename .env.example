# SAGE — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git

# NVD API — get free key at nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Anthropic — LLM patch generator (used only for patching)
ANTHROPIC_API_KEY=

# Google Gemini — LLM analyzer (free tier, used for CVE confirmation)
# Get free key at: aistudio.google.com
GEMINI_API_KEY=

# GitHub — PR automation
# Get at: GitHub Settings → Developer Settings → Personal Access Tokens → Classic
# Required scopes: repo (full)
GITHUB_TOKEN=
GITHUB_REPO=        # format: username/repo-name  e.g. anubhav/my-tool
