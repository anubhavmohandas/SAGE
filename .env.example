# SAGE — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git

# NVD API — get free key at nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Anthropic — LLM analyzer + patch generator
ANTHROPIC_API_KEY=

# GitHub — PR automation
# Use a FINE-GRAINED token (NOT a classic "repo (full)" PAT — that grants write
# to ALL your repos, which is far more than SAGE needs).
# Get at: GitHub Settings → Developer Settings → Personal Access Tokens →
#         Fine-grained tokens
#   • Repository access: only the repo(s) you scan
#   • Permissions:  Contents → Read and write
#                   Pull requests → Read and write
GITHUB_TOKEN=
GITHUB_REPO=        # format: username/repo-name  e.g. anubhav/my-tool
